# Copy to .env and fill in.

# --- Database (ADR-003) -------------------------------------------------------
# Local development uses the Docker Postgres from docker-compose.yml.
# Production/preview uses Neon; preview deployments get their own branch.
DATABASE_URL="postgresql://lockedin:lockedin@localhost:5433/lockedin?schema=public"

# Integration tests run against a separate database on the same instance so a
# test run can never truncate your development data.
TEST_DATABASE_URL="postgresql://lockedin:lockedin@localhost:5433/lockedin_test?schema=public"

# --- Auth (ADR-004) ----------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Email (ADR-005) ---------------------------------------------------------
# Any non-empty value is enough for the test suite, which never delivers mail.
# A real key is only needed to put an actual email in an actual inbox.
RESEND_API_KEY="re_local_placeholder"
# Must be a verified sender on your Resend domain.
EMAIL_FROM="LockedIn <nag@example.com>"

# --- Cron (ADR-006 / ADR-007) ------------------------------------------------
# Vercel Cron calls /api/cron/send-daily with this as a Bearer token.
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# --- AI (ADR-015 / ADR-016 / ADR-017) ----------------------------------------
# Optional. Powers the daily email's quote (ADR-017); leave AI_PROVIDER unset
# and the static quote table is used instead, same as before this existed.
#
# AI_PROVIDER picks which implementation below is built. Leave it unset for
# "not configured" — do not set it to select between "gateway" and "sarvam" by
# which key happens to be filled in; aiProviderFromEnv() throws on any other
# value, since that's a typo, not an absent config.
AI_PROVIDER=""

# gateway — get a key from the AI Gateway tab of your Vercel dashboard.
AI_GATEWAY_API_KEY=""
AI_MODEL="anthropic/claude-sonnet-5"

# sarvam — get a key from https://dashboard.sarvam.ai.
SARVAM_API_KEY=""
SARVAM_MODEL="sarvam-105b"
