# Copy to .env and fill in.

# --- Database (ADR-003) -------------------------------------------------------
# Local development uses the Docker Postgres from docker-compose.yml.
# Production/preview uses Neon; preview deployments get their own branch.
DATABASE_URL="postgresql://lockedin:lockedin@localhost:5433/lockedin?schema=public"

# Integration tests run against a separate database on the same instance so a
# test run can never truncate your development data.
TEST_DATABASE_URL="postgresql://lockedin:lockedin@localhost:5433/lockedin_test?schema=public"

# --- Auth (ADR-004) ----------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Email (ADR-005) ---------------------------------------------------------
RESEND_API_KEY=""
# Must be a verified sender on your Resend domain.
EMAIL_FROM="LockedIn <nag@example.com>"

# --- Cron (ADR-006 / ADR-007) ------------------------------------------------
# Vercel Cron calls /api/cron/send-daily with this as a Bearer token.
# Generate with: openssl rand -base64 32
CRON_SECRET=""
